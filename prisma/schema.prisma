generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories  Category[]
  expenses    Expense[]
  goals       Goal[]
  budgets     Budget[]
  savingGoals SavingGoal[]
}

model Category {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  color     String  @default("#6366f1")
  isDefault Boolean @default(false)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]
  budgets  Budget[]

  @@unique([name, userId])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime
  type        String   @default("expense") // "expense" | "income"
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, type])
}

model Goal {
  id            String  @id @default(cuid())
  name          String
  targetAmount  Decimal @db.Decimal(12, 2)
  currentAmount Decimal @default(0) @db.Decimal(12, 2)
  type          String // "saving" = risparmio, "limit" = spesa massima
  month         Int
  year          Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, month, year])
}

model SavingGoal {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("🎯")
  saved     Decimal  @default(0) @db.Decimal(12, 2)
  target    Decimal  @db.Decimal(12, 2)
  due       String // ISO date string "2026-09-01"
  accent    String   @default("#A78BFA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions GoalContribution[]

  @@index([userId, createdAt])
}

model GoalContribution {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      String // ISO date "2026-05-25"
  note      String?
  createdAt DateTime @default(now())

  goalId String
  goal   SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Budget {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(12, 2)
  month  Int
  year   Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
}
