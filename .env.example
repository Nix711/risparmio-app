# Copia questo file in .env e completa i valori: cp .env.example .env
# .env non va mai committato; questo file sì, perché non contiene segreti.

# Database locale avviato con `docker compose up -d --wait` (credenziali in docker-compose.yml).
# 127.0.0.1 e non localhost: la porta è pubblicata solo su IPv4, e localhost può risolversi in ::1.
DATABASE_URL="postgresql://balancebook:balancebook@127.0.0.1:5432/balancebook"

# Segreto con cui NextAuth firma i token di sessione. Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# Chiave AES-256-GCM per cifrare le descrizioni dei movimenti (32 byte in base64).
# Generala con: openssl rand -base64 32 — in locale usane una diversa da quella di produzione.
ENCRYPTION_KEY=""

# Serve solo per `npm run start` fuori da Vercel: con `npm run dev` NextAuth si fida già dell'host.
# AUTH_TRUST_HOST=true
